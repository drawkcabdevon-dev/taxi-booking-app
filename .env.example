# Waymaker Taxi Services — taxi booking app
# Copy to .env and fill in values. Never commit .env.

# Google Sheets — data store (tabs: Services, Bookings, Profiles)
SPREADSHEET_ID=
# Full service account JSON as a single-line string (not just the key ID)
GOOGLE_SHEETS_CREDENTIALS=

# Booking request notifications go to the business
OWNER_EMAIL=waymakertaxiservices@gmail.com

# Live ADK agent credentials. Without these, /api/chat uses the local turn.
GOOGLE_API_KEY=
# or: GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI Agent Engine resource (deployment only; not needed for /api/chat)
AGENT_ENGINE=

# API key for admin endpoints (GET /api/bookings, GET /api/profiles).
# Store the real value in Secret Manager in production.
ADMIN_KEY=

# Google Sign-In OAuth client ID (profile auto-fill)
GOOGLE_OAUTH_CLIENT_ID=

# Cloudflare Turnstile secret (server-side verification on bookings)
TURNSTILE_SECRET_KEY=

# Frontend API URL. Leave unset for the static Pages preview: the chat then
# uses the offline agent adapter with the same turn contract.
# VITE_API_BASE=http://localhost:8000/api
